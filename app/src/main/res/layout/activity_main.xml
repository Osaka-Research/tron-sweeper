<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tron Sweeper"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-forwards incoming TRX from the source wallet to the destination wallet as soon as it lands. Only use wallets you control."
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="API base URLs (one per line, raced in parallel, e.g. https://api.trongrid.io)" android:textColor="#CCCCCC" android:textSize="12sp" />
        <EditText
            android:id="@+id/edit_api_urls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="#1E1E1E"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <Button
                android:id="@+id/btn_use_shasta"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use Shasta testnet"
                android:textColor="#4FC3F7"
                android:textAllCaps="false"
                android:textSize="11sp" />
            <Button
                android:id="@+id/btn_use_nile"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use Nile testnet"
                android:textColor="#4FC3F7"
                android:textAllCaps="false"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn_open_shasta_faucet"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open Shasta faucet"
                android:textColor="#888888"
                android:textAllCaps="false"
                android:textSize="11sp" />
            <Button
                android:id="@+id/btn_open_nile_faucet"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open Nile faucet"
                android:textColor="#888888"
                android:textAllCaps="false"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No full-auto faucet here: Shasta/Nile faucets are captcha-protected web forms, unlike Solana devnet's open requestAirdrop RPC - no stable public API to automate. The buttons above just open the official claim page in your browser; you claim manually, then the sweeper (running on testnet) will pick it up and sweep it like real funds would."
            android:textColor="#777777"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="API key (optional, TRON-PRO-API-KEY header - raises TronGrid rate limits)" android:textColor="#CCCCCC" android:textSize="12sp" android:layout_marginTop="8dp" />
        <EditText
            android:id="@+id/edit_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="11sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Source wallet: 64-char hex private key, or a 12/24-word seed phrase (derived via m/44'/195'/0'/0/0) - stored encrypted on-device only"
            android:textColor="#CCCCCC" android:textSize="12sp" android:layout_marginTop="10dp" />
        <EditText
            android:id="@+id/edit_secret_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txt_derived_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#4FC3F7"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:text="" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Destination wallet address" android:textColor="#CCCCCC" android:textSize="12sp" android:layout_marginTop="10dp" />
        <EditText
            android:id="@+id/edit_dest_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Poll interval (ms)" android:textColor="#CCCCCC" android:textSize="12sp" />
                <EditText android:id="@+id/edit_poll_ms" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:text="800" android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fee reserve (sun, 1 TRX=1e6)" android:textColor="#CCCCCC" android:textSize="12sp" />
                <EditText android:id="@+id/edit_fee_reserve" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:text="2000000" android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Proxy (optional - routes all API calls through it)" android:textColor="#CCCCCC" android:textSize="12sp" android:layout_marginTop="10dp" />
        <Spinner
            android:id="@+id/spinner_proxy_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">
            <EditText android:id="@+id/edit_proxy_host" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="2" android:hint="proxy host" android:textColor="#FFFFFF" android:textColorHint="#555555" android:layout_marginEnd="6dp" />
            <EditText android:id="@+id/edit_proxy_port" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="port" android:inputType="number" android:textColor="#FFFFFF" android:textColorHint="#555555" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">
            <EditText android:id="@+id/edit_proxy_user" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="username (optional)" android:textColor="#FFFFFF" android:textColorHint="#555555" android:layout_marginEnd="6dp" />
            <EditText android:id="@+id/edit_proxy_pass" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="password (optional)" android:inputType="textPassword" android:textColor="#FFFFFF" android:textColorHint="#555555" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save config"
            android:layout_marginTop="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button android:id="@+id/btn_start" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Start" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/btn_stop" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Stop" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Log" android:textColor="#CCCCCC" android:textSize="12sp" android:layout_marginTop="12dp" />
        <TextView
            android:id="@+id/txt_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp"
            android:background="#000000"
            android:textColor="#FF4444"
            android:fontFamily="monospace"
            android:textSize="9sp"
            android:padding="8dp"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>
